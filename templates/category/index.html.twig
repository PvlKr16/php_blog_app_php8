{% extends 'base.html.twig' %}

{% block title %}Разделы{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <h1>Разделы</h1>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Добавить новый</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('category_create') }}">
                        <div class="input-group">
                            <input type="text" name="name" class="form-control" placeholder="Название нового раздела" required>
                            <button type="submit" class="btn btn-primary">Добавить</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Существующие разделы</h5>
                </div>
                <div class="card-body">
                    {% if categories is empty %}
                        <p class="text-muted">Разделов пока нет</p>
                    {% else %}
                        <div class="categories-columns">
                            <ul>
                                {% for category in categories %}
                                    <li>{{ category.name }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}