{% extends 'base.html.twig' %}

{% block title %}Редактировать профиль{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3>Редактировать профиль</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

                    {{ form_row(form.username) }}
                    {{ form_row(form.email) }}

                    <hr>

                    <div class="mb-3">
                        <label class="form-label">Текущий аватар</label>
                        <div>
                            {% if user.avatar %}
                                <div class="mb-3">
                                    <img src="/uploads/avatars/{{ user.avatar }}" alt="Avatar" class="current-avatar-preview" id="currentAvatar">
                                </div>
                            {% else %}
                                <p class="text-muted">Аватар не установлен</p>
                            {% endif %}
                        </div>
                    </div>

                    {{ include('_partials/avatar_upload_zone.html.twig', {'form': form}) }}

                    <hr>

                    {{ form_row(form.birthDate) }}
                    {{ form_row(form.address) }}
                    {{ form_row(form.about) }}

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                        <a href="{{ path('profile_view') }}" class="btn btn-secondary">Отмена</a>
                    </div>

                    {{ form_end(form) }}

                    {% if user.avatar %}
                        <hr class="mt-4">
                        <form method="post" action="{{ path('profile_avatar_delete') }}" onsubmit="return confirm('Удалить аватар?');">
                            <button type="submit" class="btn btn-danger">
                                Удалить аватар
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}