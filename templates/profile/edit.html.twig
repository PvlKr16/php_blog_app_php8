{% extends 'base.html.twig' %}

{% block title %}Редактировать профиль{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3>Редактировать профиль</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

                    {{ form_row(form.username) }}
                    {{ form_row(form.email) }}

                    <hr>

                    <div class="mb-3">
                        <label class="form-label">Текущий аватар</label>
                        <div>
                            {% if user.avatar %}
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <img src="/uploads/avatars/{{ user.avatar }}" alt="Avatar" class="current-avatar-preview" id="currentAvatar">
                                    <button type="button" class="btn btn-danger btn-sm" onclick="deleteAvatar()">
                                        Удалить аватар
                                    </button>
                                </div>
                            {% else %}
                                <p class="text-muted">Аватар не установлен</p>
                            {% endif %}
                        </div>
                    </div>

                    {{ include('_partials/avatar_upload_zone.html.twig', {'form': form}) }}

                    <hr>

                    {{ form_row(form.birthDate) }}
                    {{ form_row(form.address) }}
                    {{ form_row(form.about) }}

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                        <a href="{{ path('profile_view') }}" class="btn btn-secondary">Отмена</a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function deleteAvatar() {
            if (!confirm('Удалить аватар?')) {
                return;
            }

            fetch('{{ path('profile_avatar_delete') }}', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Ошибка при удалении аватара');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Ошибка при удалении аватара');
                });
        }
    </script>
{% endblock %}