{% extends 'base.html.twig' %}

{% block title %}Мой профиль{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3>Мой профиль</h3>
                    <a href="{{ path('profile_edit') }}" class="btn btn-primary">Редактировать</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            {% if user.avatar %}
                                <img src="/uploads/avatars/{{ user.avatar }}" alt="Avatar" class="img-fluid rounded" style="max-width: 200px;">
                            {% else %}
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="width: 200px; height: 200px; font-size: 72px;">
                                    👤
                                </div>
                            {% endif %}
                        </div>
                        <div class="col-md-9">
                            <h4>{{ user.username }}</h4>

                            <table class="table table-borderless">
                                <tr>
                                    <th style="width: 30%;">Email:</th>
                                    <td>{{ user.email }}</td>
                                </tr>
                                {% if user.department %}
                                    <tr>
                                        <th>Подразделение:</th>
                                        <td>{{ user.department.name }}</td>
                                    </tr>
                                {% endif %}
                                {% if user.birthDate %}
                                    <tr>
                                        <th>Дата рождения:</th>
                                        <td>{{ user.birthDate|date('d.m.Y') }}</td>
                                    </tr>
                                {% endif %}
                                {% if user.address %}
                                    <tr>
                                        <th>Адрес:</th>
                                        <td>{{ user.address }}</td>
                                    </tr>
                                {% endif %}
                                <tr>
                                    <th>Зарегистрирован:</th>
                                    <td>{{ user.createdAt|date('d.m.Y') }}</td>
                                </tr>
                            </table>

                            {% if user.about %}
                                <div class="mt-3">
                                    <h5>О себе</h5>
                                    <p class="text-muted">{{ user.about|nl2br }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a href="{{ path('blog_list') }}" class="btn btn-secondary">Назад к блогам</a>
            </div>
        </div>
    </div>
{% endblock %}